rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Помощники ----
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMaster() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() == 'master';
    }

    function isIgrotech() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() == 'igrotech';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ========== users — профиль игрока (PII) ==========
    match /users/{userId} {
      // Создать можно только свой профиль
      allow create: if isOwner(userId);

      // Читать: владелец, мастер, игротех (реальные ФИ, контакты, медданные)
      allow read: if isOwner(userId) || isMaster() || isIgrotech();

      // Обновлять: владелец или мастер
      allow update: if isOwner(userId) || isMaster();

      allow delete: if false;
    }

    // ========== usernames — публичный реестр позывных ==========
    match /usernames/{name} {
      // Нужен до входа (проверка уникальности при регистрации)
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isMaster();
    }

    // ========== publicPlayers — публичная проекция (без PII) ==========
    match /publicPlayers/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isMaster();
      allow delete: if isMaster();
    }

    // ========== games ==========
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== characters ==========
    match /characters/{charId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== documents ==========
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== notes ==========
    match /notes/{noteId} {
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || isMaster()
      );
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }

    // ========== tags ==========
    match /tags/{tagId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isMaster();
      allow update: if false;
    }

    // ========== subtags ==========
    match /subtags/{subtagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isMaster();
      allow update: if false;
    }

    // ========== settings ==========
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // ========== rules ==========
    match /rules/{ruleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== pages ==========
    match /pages/{pageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }
  }
}
