rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Помощники ----
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMaster() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() == 'master';
    }

    function isIgrotech() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() == 'igrotech';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Фракция игрока из публичной проекции (без PII)
    function myPublicFaction() {
      return exists(/databases/$(database)/documents/publicPlayers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/publicPlayers/$(request.auth.uid)).data.faction
        : '';
    }

    // Фракция аккаунта радиорубки
    function myRadioFaction() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.radioFaction != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.radioFaction
        : '';
    }

    // Может ли текущий пользователь читать чат (по данным документа)
    function canReadChatData(c) {
      return isSignedIn() && (
        isMaster()
        || (c.type == 'faction' && (c.faction == myPublicFaction() || c.faction == myRadioFaction()))
        || (c.type == 'master' && c.playerId == request.auth.uid)
        || (c.type == 'cross' && (
             myPublicFaction() in c.factions
             || myRadioFaction() in c.factions
           ))
        || (request.auth.uid in c.members)
      );
    }

    // ========== users — профиль игрока (PII) ==========
    match /users/{userId} {
      // Создать можно только свой профиль и только с ролью player
      allow create: if isOwner(userId)
        && request.resource.data.role == 'player';

      // Читать: владелец, мастер, игротех (реальные ФИ, контакты, медданные)
      allow read: if isOwner(userId) || isMaster() || isIgrotech();

      // Обновлять: мастер всё; владелец — только игровые данные (не role/username)
      allow update: if isMaster() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['player', 'decryptions', 'decryptedDocs', 'documents', 'lastRead'])
      );

      allow delete: if false;
    }

    // ========== usernames — публичный реестр позывных ==========
    match /usernames/{name} {
      // Нужен до входа (проверка уникальности при регистрации)
      allow read: if true;
      // Создавать можно только запись про себя
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isMaster();
    }

    // ========== publicPlayers — публичная проекция (без PII) ==========
    match /publicPlayers/{uid} {
      allow read: if isSignedIn();

      // Проекцию создаёт владелец (при регистрации) или мастер
      allow create: if isMaster() || (
        isOwner(uid) && request.resource.data.role == 'player'
      );

      // Владелец может менять только публичные поля, роль — только мастер
      allow update: if isMaster() || (
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'gameId', 'characterName', 'faction', 'updatedAt'])
      );

      allow delete: if isMaster();
    }

    // ========== factionComments — комментарии о людях во фракции ==========
    match /factionComments/{targetId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMaster();
    }

    // ========== games ==========
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== characters ==========
    match /characters/{charId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== professions — каталог профессий ==========
    match /professions/{profId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== chats — каналы связи ==========
    match /chats/{chatId} {
      allow read: if canReadChatData(resource.data);

      allow create: if isSignedIn() && (
        isMaster()
        || (request.resource.data.type == 'faction')
        || (request.resource.data.type == 'dm' && request.auth.uid in request.resource.data.members)
        || (request.resource.data.type == 'master' && request.resource.data.playerId == request.auth.uid)
        || (request.resource.data.type == 'cross' && (
             myRadioFaction() in request.resource.data.factions
             || myPublicFaction() in request.resource.data.factions
           ))
      );

      allow update: if isMaster() || (
        (resource.data.type == 'faction' && resource.data.faction == myPublicFaction())
        || (resource.data.type == 'dm' && request.auth.uid in resource.data.members)
        || (resource.data.type == 'master' && resource.data.playerId == request.auth.uid)
        || (resource.data.type == 'cross' && (
             myRadioFaction() in resource.data.factions
             || myPublicFaction() in resource.data.factions
           ))
      );

      allow delete: if isMaster();

      match /messages/{messageId} {
        allow read: if canReadChatData(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if canReadChatData(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ========== radioSessions — сессии радиорубки ==========
    match /radioSessions/{roomUid} {
      // Читать может любой авторизованный: хакеру нужен след и доступы целевой рубки
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMaster();
    }

    // ========== radioCodes — коды получателя ==========
    match /radioCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isMaster();
    }

    // ========== techAccounts — технические учётки радиорубок ==========
    // Пароли хранятся в открытом виде и доступны только мастерам
    match /techAccounts/{id} {
      allow read, write: if isMaster();
    }

    // ========== logs — журнал для мастеров ==========
    match /logs/{logId} {
      allow read: if isMaster();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ========== documents ==========
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== notes ==========
    match /notes/{noteId} {
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || isMaster()
      );
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }

    // ========== tags ==========
    match /tags/{tagId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isMaster();
      allow update: if false;
    }

    // ========== subtags ==========
    match /subtags/{subtagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isMaster();
      allow update: if false;
    }

    // ========== settings ==========
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // ========== rules ==========
    match /rules/{ruleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }

    // ========== pages ==========
    match /pages/{pageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();
    }
  }
}
